# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL connection ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=nova_async

# ─── Firebase Admin SDK Credentials ──────────────────────────────────────────
# Set your Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Option A: Path to service account JSON file (do NOT commit the JSON file!)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Option B: Inline credentials for production deployment / secrets
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ─── Gemini AI Companion ──────────────────────────────────────────────────────
# Obtain your key from Google AI Studio: https://aistudio.google.com/app/apikey
# NEVER commit a real key. This file is for variable names only.
GEMINI_API_KEY=

# Set to "true" to enable the AI companion endpoint (POST /api/ai/chat).
# Any other value (or absence) leaves the endpoint disabled and returns 503.
# Requires a server restart after changing (dotenv loads at startup).
AI_ENABLED=
