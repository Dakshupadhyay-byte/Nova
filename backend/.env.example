# ─── Server ──────────────────────────────────────────────────────────────────
# The port the HTTP server will listen on.
# Default fallback in server.js is 5000.
PORT=5000

# ─── PostgreSQL connection ────────────────────────────────────────────────────
# These map directly to the 'pg' Pool config object.
# Never put real credentials here — this file is committed to version control
# as a documentation artifact only. Copy to `.env` and fill in real values.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=nova_async

# ─── App Environment ─────────────────────────────────────────────────────────
# Controls logging verbosity, error detail in responses, etc.
# Values: development | production | test
NODE_ENV=development

